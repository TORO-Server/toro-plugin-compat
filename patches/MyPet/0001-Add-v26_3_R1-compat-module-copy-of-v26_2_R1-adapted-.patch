+		builder.define(SADDLE_CHEST_WATCHER, (byte) 0);    // saddle & chest
+		builder.define(CHEST_WATCHER, false);
+		builder.define(STRENGTH_WATCHER, 0);
+		//builder.define(COLOR_WATCHER, 0);
+		builder.define(VARIANT_WATCHER, 0);
+	}
