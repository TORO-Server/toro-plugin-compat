+			return InteractionResult.CONSUME;
+		}
+
+		if (getOwner().equals(entityhuman) && itemStack != null && canUseItem()) {
+			if (itemStack.getItem() == Item.byBlock(Blocks.PUMPKIN) && getMyPet().isSheared() && entityhuman.isShiftKeyDown()) {
